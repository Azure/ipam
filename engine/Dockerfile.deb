ARG BASE_IMAGE=python:3.12-slim-trixie
FROM $BASE_IMAGE

# Set Production Build Flag
ARG PROD_BUILD=true

# Set Default Port
ARG PORT=8080

# IPAM Version (for OCI Image Label)
ARG IPAM_VERSION=0.0.0

# Set Environment Variable
ENV PORT=${PORT}

# Disable PIP Root Warnings
ENV PIP_ROOT_USER_ACTION=ignore

# OCI Image Labels
LABEL org.opencontainers.image.title="Azure IPAM Engine" \
      org.opencontainers.image.version="${IPAM_VERSION}" \
      org.opencontainers.image.source="https://github.com/Azure/ipam"

# Set the Working Directory
WORKDIR /ipam

# Create Non-Root User (UID 1001, GID 0 to match the RHEL image)
RUN useradd --uid 1001 --gid 0 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin ipam

# Copy Requirements File
COPY ./requirements.txt .
COPY ./requirements.lock.txt .

# Upgrade PIP
RUN pip install --no-cache-dir --upgrade pip --progress-bar off

# Install Dependencies
RUN if [ "${PROD_BUILD}" = true ]; then \
  pip install --no-cache-dir -r ./requirements.lock.txt --progress-bar off; \
else \
  pip install --no-cache-dir -r ./requirements.txt --progress-bar off; \
fi

# Copy Application Scripts & Sources
COPY ./app ./app
COPY ./init.sh .

# Set Script Execute Permissions
RUN chmod +x init.sh

# Switch to Non-Root User
USER 1001

# Expose Port
EXPOSE $PORT

# Execute Startup Script
ENTRYPOINT ["/bin/sh", "-c", "exec ./init.sh ${PORT}"]
